{
  "name": "@ant/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "tsx watch src/web.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "start:web": "node dist/web.js",
    "start:worker": "node dist/worker.js"
  },
  "dependencies": {
    "@ant/shared": "workspace:*",
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@anthropic-ai/sdk": "0.93.0",
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.1.2",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "@fastify/websocket": "11.3.4",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@node-rs/argon2": "2.2.2",
    "@simplewebauthn/server": "13.3.3",
    "cron-parser": "5.10.2",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.5",
    "otplib": "12.0.1",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "web-push": "3.6.7",
    "ws": "8.22.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/web-push": "3.6.4",
    "@types/ws": "8.18.2",
    "drizzle-kit": "0.31.11",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
