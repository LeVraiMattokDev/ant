# ───────────── Ant : variables d'environnement ─────────────
# Copie ce fichier en .env (ou lance deploy/generate-env.sh), droits 600, jamais versionné.
# Garde une copie de .env hors de la machine (gestionnaire de mots de passe) : sans le même ENCRYPTION_KEY,
# une sauvegarde restaurée ailleurs n'accepte plus les codes TOTP (voir README § 9).

# Adresse publique d'Ant (HTTPS via Nginx Proxy Manager). Obligatoire pour les passkeys et les cookies sécurisés.
PUBLIC_ORIGIN=https://ant.example.com

# Fuseau horaire des conteneurs (les réglages d'Ant ont leur propre fuseau, défaut Europe/Zurich).
TZ=Europe/Zurich

# Secrets internes (générés par deploy/generate-env.sh).
POSTGRES_PASSWORD=
ENCRYPTION_KEY=
COMPUTER_RPC_TOKEN=
# Jeton d'initialisation du premier compte, à saisir sur /setup : grep ^SETUP_TOKEN= .env
# S'il est vide, un jeton aléatoire est affiché dans « docker compose logs web » (nouveau à chaque démarrage).
SETUP_TOKEN=

# ───────────── Connexion à Claude (service worker uniquement) ─────────────
# Abonnement Pro/Max : jeton longue durée (1 an) généré avec `claude setup-token`. Voir README.
CLAUDE_CODE_OAUTH_TOKEN=
# Crédits API de la Claude Console (repli et travail autonome en mode « hybride prudent »).
ANTHROPIC_API_KEY=

# ───────────── Notifications Web Push ─────────────
# Générer : docker compose run --rm --no-deps --entrypoint npx web web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:toi@example.com

# ───────────── Réseau et ressources ─────────────
# Adresse d'écoute du port web sur la VM (mettre l'IP de la VM pour n'écouter que sur le LAN de NPM).
ANT_BIND_ADDRESS=0.0.0.0
# Proxys autorisés à fixer l'adresse IP du client (X-Forwarded-For), utilisée pour limiter les tentatives
# de connexion et dans l'Audit. Par défaut : toutes les adresses privées, donc ton LAN mais aussi les réseaux
# Docker, dont celui de l'ordinateur des agents (qui pourrait alors choisir son adresse). Dès la première
# connexion, remplace-les par l'IP exacte de NPM telle qu'Ant la voit (champ peerAddress de
# https://<ton domaine>/api/system/network), puis : docker compose up -d web. Voir README § 7.
# Jamais « true » : NPM ajoute l'adresse réelle à la fin de l'en-tête, un client choisirait alors la sienne.
TRUST_PROXY=loopback,linklocal,uniquelocal
ANT_PORT=8080
COMPUTER_MEMORY=3g
COMPUTER_CPUS=2

# ───────────── Sauvegardes ─────────────
# Dossier des dumps sur la machine, hors du dépôt git (créé au premier démarrage). Sur un NAS dans un LXC : README § 3.
BACKUP_DIR=/var/backups/ant
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=3

LOG_LEVEL=info
