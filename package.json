{
  "name": "ant",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:deploy": "node --test deploy/tests/*.test.mjs",
    "dev:web": "pnpm --filter @ant/server dev:web",
    "dev:worker": "pnpm --filter @ant/server dev:worker",
    "dev:ui": "pnpm --filter @ant/ui dev"
  }
}
